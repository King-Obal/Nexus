{
  "name": "nexus",
  "version": "1.0.3",
  "productName": "Nexus",
  "description": "Nexus - MTG Duel Commander Interface",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --dir"
  },
  "keywords": [],
  "author": "Maxime",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.nexus.mtg",
    "productName": "Nexus",
    "directories": {
      "output": "../release-tmp/build"
    },
    "asar": false,
    "win": {
      "target": "dir",
      "icon": "src/card-back.png",
      "signAndEditExecutable": false
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!test-main*.js"
    ]
  }
}
